# ==============================================================================
# Serviço de automação (Google Calendar) — copie para .env e preencha
# ==============================================================================

# Porta do serviço HTTP
PORT=3333

# Token simples para proteger a API (o Chatbot/n8n envia em Authorization: Bearer)
API_TOKEN=troque-por-um-token-secreto

# --- Credenciais da Conta de Serviço do Google --------------------------------
# Vêm do arquivo JSON gerado no Google Cloud (client_email e private_key).
GOOGLE_CLIENT_EMAIL=nome-da-conta@seu-projeto.iam.gserviceaccount.com
# A private_key deve ficar em UMA linha, com as quebras escritas como \n literais.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# ID da agenda onde os eventos serão criados.
# Para a agenda principal use "primary" OU o e-mail da agenda compartilhada.
GOOGLE_CALENDAR_ID=primary

# Fuso horário dos eventos
GOOGLE_TIMEZONE=America/Sao_Paulo

# --- Expediente da clínica ----------------------------------------------------
# Padrão: Terça a Sábado (2,3,4,5,6), 09h–18h, almoço 12h00–13h30.
CLINIC_UTC_OFFSET=-3
CLINIC_WORKDAYS=2,3,4,5,6
CLINIC_OPEN_HOUR=9
CLINIC_CLOSE_HOUR=18
CLINIC_SLOT_STEP=30
CLINIC_LUNCH_START=12:00
CLINIC_LUNCH_END=13:30
